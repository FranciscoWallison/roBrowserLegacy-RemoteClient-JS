PORT=3338
CLIENT_PUBLIC_URL=http://127.0.0.1:8000
NODE_ENV=development

# CORS: CLIENT_PUBLIC_URL is allowed on top of the local dev ports (8000, 8080, 3338).
# CORS_ORIGINS replaces that whole list: comma-separated origins, or * for any origin.
#   CORS_ORIGINS=https://play.example.com,https://www.example.com
#CORS_ORIGINS=

# File search, used by the map, model and GRF viewers (not by the game). false answers every
# search with an empty list.
#CLIENT_ENABLESEARCH=true

# Cache settings
CACHE_MAX_FILES=5000
CACHE_MAX_MEMORY_MB=1024

# Warm-up: pre-loads frequently used assets into cache on startup
# CACHE_WARM_UP=true  - Enable cache warm-up
# CACHE_WARM_UP_LIMIT=500  - Max files to pre-load
CACHE_WARM_UP=true
CACHE_WARM_UP_LIMIT=500

# Unified server settings
# ENABLE_WSPROXY=true  - Embeds WebSocket proxy (replaces standalone wsproxy)
# ENABLE_STATIC_SERVE=true - Serves roBrowserLegacy static files (replaces live-server)
ENABLE_WSPROXY=true
ENABLE_STATIC_SERVE=true
ROBROWSER_PATH=../roBrowserLegacy

# WS proxy target allowlist (only used when ENABLE_WSPROXY=true)
# Comma-separated "host:port" pairs the proxy is permitted to forward to.
# Defaults to localhost only (127.0.0.1:6900, 6121, 5121) when not set.
# Override for non-host-network deployments where rAthena is on a different host:
#   WS_ALLOWED_TARGETS=10.0.0.5:6900,10.0.0.5:6121,10.0.0.5:5121
# Docker Desktop (macOS/Windows):
#   WS_ALLOWED_TARGETS=host.docker.internal:6900,host.docker.internal:6121,host.docker.internal:5121
#WS_ALLOWED_TARGETS=

# ESRGAN upscaling plugin (@chicowall/robrowser-esrgan)
# Serves AI-upscaled textures/sprites from a pre-built disk cache.
# When enabled, asset requests are intercepted and served from the cache
# before falling through to GRF lookup. Zero overhead when disabled.
# Install: npm install github:FranciscoWallison/robrowser-esrgan
# Populate cache: python tools/esrgan_pipeline/orchestrate.py
#ESRGAN_ENABLED=true
#ESRGAN_CACHE_DIR=./upscaled_cache

# Client folders kept outside the project (absolute, or relative to the project).
# DATA_OVERRIDE_PATH: loose data files that are NOT inside the GRF (msgstringtable.txt,
#   translated tables). Checked after the project's own data/ and before the GRFs.
# BGM_PATH / SYSTEM_PATH / AI_PATH: the client's music, fonts and AI scripts, served
#   read-only for requests under BGM/, System/ and AI/ -- no copying, no junctions.
# A folder set here must exist; startup validation fails otherwise.
#DATA_OVERRIDE_PATH=../cliente_exe/data
#BGM_PATH=../cliente_exe/BGM
#SYSTEM_PATH=../cliente_exe/System
#AI_PATH=../cliente_exe/AI

# Write every file read from a GRF into the project's data/ folder. Off by default:
# the copies are read before DATA_OVERRIDE_PATH and would hide its translated files.
#CLIENT_AUTOEXTRACT=false
